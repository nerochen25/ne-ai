    "@radix-ui/react-dialog": "1.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "highlight.js": "11.12.0",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "next-themes": "0.4.6",
    "openai": "7.32.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
