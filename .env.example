# Copy to .env.local. Never commit real credentials.
APP_URL=http://localhost:3000
DATABASE_URL=mysql://neai:password@127.0.0.1:3306/neai
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
OWNER_CLERK_IDS=
OPENAI_API_KEY=
# Explicitly choose models available to your API project. No implicit model default.
OPENAI_TEXT_MODEL=
# Chat can search for current information. Tool calls incur additional provider costs.
OPENAI_WEB_SEARCH=true
# Supported family: gpt-image-*. Must accept PNG, medium quality and the listed canvas sizes.
OPENAI_IMAGE_MODEL=
DAILY_REQUEST_LIMIT=50
# Cloudflare R2: region=auto, use the dashboard S3 endpoint, leave SSE empty.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_SERVER_SIDE_ENCRYPTION=AES256
# Random secret for authenticated job dispatch (at least 32 random bytes recommended).
CRON_SECRET=
# Optional media: enable only after testing the selected model's input/output contract.
REPLICATE_API_TOKEN=
REPLICATE_MUSIC_VERSION=
REPLICATE_MUSIC_PROMPT_FIELD=prompt
REPLICATE_MUSIC_VERIFIED=false
REPLICATE_VIDEO_VERSION=
REPLICATE_VIDEO_PROMPT_FIELD=prompt
REPLICATE_VIDEO_VERIFIED=false
